# Database Configuration
# Update these values with your MySQL database credentials

# Database host (usually localhost for local development)
DB_HOST=localhost

# Database username (default is 'root' for MySQL)
DB_USER=root

# Database password (update with your MySQL password)
DB_PASSWORD=your_password_here

# Database name (the database must exist in MySQL)
DB_NAME=todo_db

# Database port (default MySQL port is 3306)
DB_PORT=3306

# Node Environment (development or production)
NODE_ENV=development

# Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Update the values in .env.local with your actual database credentials
# 3. Make sure your MySQL database 'todo_db' exists
# 4. Run: CREATE DATABASE todo_db; (if it doesn't exist)
